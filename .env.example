# Copy this file to .env and fill in real values. Never commit .env to git.

# --- Database ---
DATABASE_URL=postgresql://btb:btb_dev_password@localhost:5432/btb_trading

# --- Cache / sessions ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_value
JWT_REFRESH_SECRET=replace_with_a_different_long_random_value

# --- Market data provider (choose a licensed provider, e.g. Coinbase Exchange, Kraken) ---
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=

# --- Wallet / custody provider (e.g. Fireblocks, BitGo, Copper) ---
WALLET_PROVIDER_API_KEY=
WALLET_PROVIDER_SECRET=
WALLET_PROVIDER_WEBHOOK_SECRET=

# --- Email (verification, notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- App ---
NODE_ENV=development
CUSTOMER_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
